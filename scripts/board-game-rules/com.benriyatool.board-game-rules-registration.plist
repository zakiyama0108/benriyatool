<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd 定期起動設定の雛形(仕様: specs/board-game-rules/admin/design.md「ローカル環境の定期処理」
  「セキュリティ」、admin/tasks.md T9)。

  使い方:
    1. このファイルを ~/Library/LaunchAgents/com.benriyatool.board-game-rules-registration.plist へコピーする。
    2. 下記プレースホルダを実値に置き換える(いずれもパス。資格情報は含めない):
       - __NODE_BIN__   : `which node` の絶対パス(例 /opt/homebrew/bin/node、nvm なら
                          /Users/you/.nvm/versions/node/v22.x/bin/node)
       - __REPO_DIR__   : このリポジトリの絶対パス
       - __CLAUDE_BIN__ : `which claude` の絶対パス
    3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.benriyatool.board-game-rules-registration.plist
       (旧来の `launchctl load` は非推奨。実機では HOME を欠いた劣化コンテキストで起動し、
        claude -p が ~/.claude を読めず失敗した。必ず bootstrap gui/<uid> を使う。
        入れ直しは `launchctl bootout gui/$(id -u)/com.benriyatool.board-game-rules-registration` してから再 bootstrap)
    4. launchctl list | grep board-game で常駐(=定期起動が登録されている)ことを確認する。
       StandardOutPath / StandardErrorPath のログに 60 秒間隔でエラーなく起動していること
       (処理対象がなければ「処理対象の依頼(status=queued)はありません」で即終了する)を確認する。

  資格情報の扱い(design.md「セキュリティ」):
    - このplistには資格情報の実値を一切書かない。processRegistrationQueue.ts が
      __REPO_DIR__/.env.local を dotenv で明示読み込みするため、NEXT_PUBLIC_SUPABASE_URL /
      SUPABASE_SERVICE_ROLE_KEY(RLS全バイパスの全権キー)/ GEMINI_API_KEY /
      CLAUDE_CODE_OAUTH_TOKEN は .env.local 側にだけ置けばよい(plist へのコピー不要)。
    - コミットしてよいのはこの雛形のみ。プレースホルダを実パスに置換した稼働用 plist は
      ~/Library/LaunchAgents/ 側にのみ置き、リポジトリには戻さない。
    - launchd は対話シェルの PATH・環境変数を引き継がないため、node / claude は絶対パスで指定する
      (claude の絶対パスは BGR_CLAUDE_BIN で processRegistrationQueue.ts へ渡す)。
    - StartInterval=60 で60秒ごとに起動する(常駐プロセスは持たない)。処理対象がなければ即終了する。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.benriyatool.board-game-rules-registration</string>

  <!--
    scripts/board-game-rules/ は本体 package.json から隔離した独自の package.json を持つ
    (初回のみ `cd scripts/board-game-rules && npm install` が必要)。node の --import で
    ローカル node_modules の tsx をローダーとして読み込む。WorkingDirectory をこのディレクトリに
    することで node が tsx を解決できる(スクリプト内の .env.local / SKILL.md の参照は
    import.meta.url 基準の相対パスなので cwd に依存しない)。
  -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>--import</string>
    <string>tsx</string>
    <string>__REPO_DIR__/scripts/board-game-rules/processRegistrationQueue.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_DIR__/scripts/board-game-rules</string>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <true/>

  <!--
    ジョブ本体(processRegistrationQueue.ts)の終了時、同じプロセスグループに残った子プロセス
    (タイムアウト等で残存した claude -p など)も launchd がまとめて終了させる。孤児プロセスを
    残さないための既定動作を明示している(true にすると残存プロセスを放置する)。
    なお StartInterval のジョブは前回の実行が終わるまで再起動されないため、多重起動はこの設定とは
    無関係に起きない。
  -->
  <key>AbandonProcessGroup</key>
  <false/>

  <!--
    資格情報は EnvironmentVariables に書かない(design.md「セキュリティ」)。
    processRegistrationQueue.ts が __REPO_DIR__/.env.local を読み込むため、ここで渡すのは
    claude の絶対パス(BGR_CLAUDE_BIN)と、対話シェルを介さない最小限の PATH のみ。
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>BGR_CLAUDE_BIN</key>
    <string>__CLAUDE_BIN__</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__REPO_DIR__/scripts/board-game-rules/processRegistrationQueue.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_DIR__/scripts/board-game-rules/processRegistrationQueue.err.log</string>
</dict>
</plist>
